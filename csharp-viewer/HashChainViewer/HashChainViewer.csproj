<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HashChainViewer</RootNamespace>
    <AssemblyName>HashChainViewer</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Robert Lafore / Ported to C# .NET 8.0</Authors>
    <Description>Separate-Chaining Hash Table Applet ported from Robert Lafore's Data Structures and Algorithms in Java (Chapter 11).</Description>
  </PropertyGroup>

</Project>
